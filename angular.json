{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false,
    "schematicCollections": ["angular-eslint"]
  },
  "newProjectRoot": "projects",
  "projects": {
    "ngx-gorilla-ui": {
      "projectType": "library",
      "root": "projects/ngx-gorilla-ui",
      "sourceRoot": "projects/ngx-gorilla-ui",
      "prefix": "gorilla",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-gorilla-ui/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-gorilla-ui/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-gorilla-ui/tsconfig.spec.json",
            "browsers": ["chromium"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-gorilla-ui/**/*.ts",
              "projects/ngx-gorilla-ui/**/*.html"
            ]
          }
        }
      }
    },
    "ngx-gorilla-ui-catalog": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "css"
        }
      },
      "root": "projects/ngx-gorilla-ui-catalog",
      "sourceRoot": "projects/ngx-gorilla-ui-catalog/src",
      "prefix": "gorilla",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/ngx-gorilla-ui-catalog/src/main.ts",
            "tsConfig": "projects/ngx-gorilla-ui-catalog/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/ngx-gorilla-ui-catalog/public"
              }
            ],
            "styles": [
              "dist/ngx-gorilla-ui/styles/tokens.css",
              "projects/ngx-gorilla-ui-catalog/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "ngx-gorilla-ui-catalog:build:production"
            },
            "development": {
              "buildTarget": "ngx-gorilla-ui-catalog:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-gorilla-ui-catalog/tsconfig.spec.json",
            "browsers": ["chromium"]
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-gorilla-ui-catalog/**/*.ts",
              "projects/ngx-gorilla-ui-catalog/**/*.html"
            ]
          }
        }
      }
    }
  }
}
